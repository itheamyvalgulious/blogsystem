{
  "name": "@blog-system/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup src/main.ts src/preload.ts --format cjs --target node22 --out-dir dist --splitting false --clean --external electron",
    "package:win": "node ../../scripts/package-electron.mjs --mode=both",
    "package:win:local": "node ../../scripts/package-electron.mjs --mode=local",
    "package:win:remote": "node ../../scripts/package-electron.mjs --mode=remote",
    "start": "node ../../scripts/run-electron.mjs apps/desktop",
    "test": "tsx --test \"src/pdf-export-helpers.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "electron": "^42.4.0"
  }
}
